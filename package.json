{
  "name": "aidlc-salesforce",
  "private": true,
  "version": "1.0.0",
  "description": "AI-DLC kit for Salesforce development with a lead-scoring demo",
  "scripts": {
    "lint": "eslint \"force-app/**/lwc/**/*.js\" --no-error-on-unmatched-pattern",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "check:kit": "node scripts/check-kit.js",
    "prettier": "prettier --write \"force-app/**/*.{cls,css,html,js,trigger,xml}\"",
    "aidlc": "node scripts/aidlc-run.js",
    "test:runner": "node scripts/test-runner.js",
    "aidlc:ui": "node scripts/aidlc-ui/server.js",
    "test:ui": "node scripts/test-ui.js"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  }
}
